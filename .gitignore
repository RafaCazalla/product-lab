# Datos de usuarios: NO van al repositorio.
# El panel se hidrata en local con:
#   python3 tools/reviews_build.py <csv de Play> --inline index.html
# y el index.html del repositorio lleva el esqueleto vacío
#   python3 tools/reviews_build.py --empty --inline index.html
data/
*.csv

# CSV de encuestas: la columna "Usuario" es un token de registro de FCM, o sea
# una credencial con la que se puede enviar una notificacion a ese telefono.
# Lo cubre ya *.csv, pero va explicito para que se vea al leer el fichero.
datasurvey/

# Assets de marca en crudo (el logo va incrustado en index.html)
*.png
!docs/**/*.png

# Credenciales. La clave de la cuenta de servicio de Google Play vive FUERA del
# repositorio, en ~/.config/besoccer/play-sa.json con permisos 600: lo que no
# esta aqui no se puede publicar por accidente. Estas reglas son la segunda
# barrera, por si alguna vez alguien la copia dentro sin pensarlo.
*play-sa*.json
*service-account*.json
*credentials*.json

.DS_Store
